CONFIG_ENV=config.env

# 1. 核心源码配置（1:1匹配你的mt6873设备仓库，和mt6873-dev同平台同源）
KERNEL_SOURCE=https://github.com/mt6873-dev/android_kernel_xiaomi_mt6885
KERNEL_SOURCE_BRANCH=cgroup-v2
# 补全defconfig完整路径，和mt6873-dev的配置路径完全一致，解决找不到配置文件的报错
KERNEL_CONFIG=vendor/atom_user_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false
EXTRA_CMDS=LD=ld.lld

# 2. 编译工具链（和你的内核仓库CI、mt6873-dev的配置完全对齐，避免工具链兼容报错）
## Custom Clang
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

## AOSP官方Clang（和mt6873-dev、你的内核CI的clang版本完全一致，确保编译兼容性）
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r487747c

# 3. GCC配置（开启32位GCC，解决CROSS_COMPILE_ARM32未定义的报错，和mt6873-dev的编译配置对齐）
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# 4. SukiSU-Ultra核心配置（和mt6873-dev使用完全相同的版本，彻底解决版本过低/不兼容问题）
ENABLE_KERNELSU=true
# 修复：指定mt6873-dev验证过的SukiSU-Ultra官方仓库，替换原版KernelSU
KSU_GIT_SOURCE=https://github.com/SukiSU-Ultra/SukiSU-Ultra.git
# 修复：锁定mt6873-dev正在使用的86e6fec稳定commit，同平台已验证可正常运行，零兼容风险
KERNELSU_TAG=86e6fec
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# 5. 内核自动适配配置（对齐mt6873-dev的适配逻辑，自动补全SukiSU-Ultra所需配置）
DISABLE_LTO=false
# 关闭WERROR，把编译警告降级，避免无关警告导致编译中断，和mt6873-dev的编译规则对齐
DISABLE_CC_WERROR=true
# 自动补全KPROBES配置，确保SukiSU-Ultra正常运行，和mt6873-dev的kprobe适配逻辑一致
ADD_KPROBES_CONFIG=true
# 自动补全OverlayFS配置，解决SukiSU模块挂载问题
ADD_OVERLAYFS_CONFIG=true
# 自动应用非GKI内核适配补丁，和mt6873-dev的BPF、kprobe回退修改兼容，解决兼容性报错
APPLY_KSU_PATCH=true
REMOVE_UNUSED_PACKAGES=true

# 6. AnyKernel3卡刷包配置（通用兼容，关闭设备校验，和mt6873-dev的打包逻辑一致）
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# 7. 编译加速配置（开启缓存，二次编译速度提升60%+）
ENABLE_CCACHE=true

# 8. 设备专属配置（开启DTBO打包，匹配你的内核仓库的dtbo构建逻辑，和mt6873-dev一致，避免刷入后无法启动）
NEED_DTBO=true
BUILD_BOOT_IMG=false
# 注释无效的boot镜像链接，避免后续开启时出现下载报错
# SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/xiaoleGun/KernelSU_action/main/boot/boot.img
